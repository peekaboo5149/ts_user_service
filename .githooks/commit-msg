#!/bin/sh
#
# commit-msg hook — enforces Conventional Commits
# https://www.conventionalcommits.org/en/v1.0.0/#specification
#

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Allow merge and revert commits without validation
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
    exit 0
fi

if echo "$COMMIT_MSG" | grep -qE "^Revert \""; then
    exit 0
fi

# Extract the first line (subject)
SUBJECT=$(echo "$COMMIT_MSG" | head -n 1)

# Conventional commit regex
# <type>[optional scope][optional !]: <description>
PATTERN="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9-]+\))?!?: .+$"

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
    echo ""
    echo "ERROR: Commit message does not follow Conventional Commits."
    echo ""
    echo "Expected format:"
    echo "  <type>[optional scope][optional !]: <description>"
    echo ""
    echo "Allowed types:"
    echo "  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
    echo ""
    echo "Examples:"
    echo "  feat: add user authentication"
    echo "  fix(api): resolve null pointer exception"
    echo "  feat!: redesign user profile schema"
    echo "  docs(readme): update installation steps"
    echo ""
    echo "Your subject line was:"
    echo "  $SUBJECT"
    echo ""
    exit 1
fi

exit 0
